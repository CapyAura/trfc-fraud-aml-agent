# Optional embedding keys. Uncomment and set at most one; OpenAI takes precedence.
# Without either key, embeddings use deterministic offline hashing.
# OPENAI_API_KEY=replace_with_openai_api_key
# JINA_API_KEY=replace_with_jina_api_key

# Needed only for real agent LLM calls. GROQ_API_KEY takes precedence over
# the fallback LLM_API_KEY. Uncomment and set one; neither is needed for tests
# or the evaluation dry run.
# GROQ_API_KEY=replace_with_groq_api_key
# LLM_API_KEY=replace_with_groq_api_key
# Optional Groq model override; code has its own default.
# LLM_MODEL=replace_with_groq_model_name

# Optional isolated SQLite database for controlled test runs. Use an absolute,
# disposable path; isolated writes are blocked if this is unset or points to
# the repository's default data/state.db.
# TRFC_STATE_DB=replace_with_disposable_sqlite_path
# TRFC_REQUIRE_ISOLATED_DB=1
